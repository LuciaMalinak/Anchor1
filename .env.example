DATABASE_URL="postgresql://user:password@localhost:5432/anchor_dev"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-33"
AUTH_URL="http://localhost:3000"

# Email — team invites, "send summary" recaps, AND magic-link sign-in all
# go through SendGrid (see src/lib/email.ts). Get a free key at
# https://sendgrid.com, then verify one sender address under Settings >
# Sender Authentication > Single Sender Verification (no domain needed) —
# SENDGRID_FROM_EMAIL must be that exact verified address, or every email
# this app sends, including magic-link sign-in, fails.
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""

# "Sign in with Google" on /sign-in — https://console.cloud.google.com/apis/credentials
# A SEPARATE OAuth client from GOOGLE_INTEGRATION_CLIENT_ID/SECRET below
# (that pair is only for the Gmail/Calendar data integration on the
# Integrations page) — set up its own client, with redirect URI
# {AUTH_URL}/api/auth/callback/google. Optional: without both of these
# set, the "Continue with Google" button just doesn't render.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Transcription — get a free key at https://www.assemblyai.com
ASSEMBLYAI_API_KEY=""

# Summarization — https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Automatic meeting-join bot — https://recall.ai
RECALL_API_KEY=""
RECALL_REGION="us-east-1"
RECALL_WEBHOOK_SECRET="generate-your-own-random-string"

# "Sign in with LinkedIn" — https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# Integrations (Dashboard > Integrations) — each is optional; a card on
# that page just shows "Needs setup" until its two vars are both set.
# Redirect URI to register with each provider:
#   {AUTH_URL}/api/integrations/<google|microsoft|slack|salesforce>/callback

# Google (Gmail + Calendar) — https://console.cloud.google.com/apis/credentials
# Connecting is read-only by default. The meeting page's "Save to Gmail drafts"
# and "Add to calendar" ask for gmail.compose / calendar.events on first use,
# so add those two scopes to the OAuth consent screen's Data access list too.
GOOGLE_INTEGRATION_CLIENT_ID=""
GOOGLE_INTEGRATION_CLIENT_SECRET=""

# Microsoft 365 (Outlook + Teams) — https://portal.azure.com (App registrations)
MICROSOFT_INTEGRATION_CLIENT_ID=""
MICROSOFT_INTEGRATION_CLIENT_SECRET=""

# Slack — https://api.slack.com/apps
SLACK_INTEGRATION_CLIENT_ID=""
SLACK_INTEGRATION_CLIENT_SECRET=""

# Dropbox — https://www.dropbox.com/developers/apps (Scoped access, Full
# Dropbox). Permissions: account_info.read, files.metadata.read,
# files.content.read. Redirect URI: {AUTH_URL}/api/integrations/dropbox/callback
DROPBOX_INTEGRATION_CLIENT_ID=""
DROPBOX_INTEGRATION_CLIENT_SECRET=""

# Google Drive needs no keys of its own: it uses the Google (Gmail +
# Calendar) client above. Add the drive.readonly scope to its OAuth consent
# screen.

# Salesforce — set up a Connected App under Setup > App Manager in your
# Salesforce org, with OAuth enabled and the callback URL above registered.
SALESFORCE_INTEGRATION_CLIENT_ID=""
SALESFORCE_INTEGRATION_CLIENT_SECRET=""

# HubSpot — create an app at developers.hubspot.com, add the callback URL
# above as a redirect URL, and grant the crm.objects.contacts.read /
# crm.objects.deals.read scopes.
HUBSPOT_INTEGRATION_CLIENT_ID=""
HUBSPOT_INTEGRATION_CLIENT_SECRET=""

# File storage (profile photos, meeting recordings, deal files). Without
# this, uploads are written to local disk, which does NOT survive a
# restart or redeploy on Render's free tier — set this up before relying
# on uploaded files sticking around. Get these from a free Cloudflare
# account: dash.cloudflare.com -> R2 Object Storage -> create a bucket ->
# "Manage API Tokens" -> create a token with Object Read & Write on that
# bucket. R2_ACCOUNT_ID is in the R2 dashboard URL / account home.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
