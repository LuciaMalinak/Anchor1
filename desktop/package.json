{
  "name": "anchor-desktop",
  "version": "0.2.1",
  "private": true,
  "description": "Anchor Desktop — records Zoom/Teams/Meet calls locally with no bot joining, using Recall.ai's Desktop Recording SDK.",
  "author": "Anchor",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@recallai/desktop-sdk": "^2.0.32",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "build": {
    "appId": "com.anchor.desktop",
    "productName": "Anchor Desktop",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "generic",
      "url": "https://anchor-be6o.onrender.com/api/desktop-app/updates",
      "channel": "latest"
    },
    "files": ["dist/**/*", "src/renderer/**/*", "package.json"],
    "protocols": {
      "name": "Anchor Desktop Connect",
      "schemes": ["anchor-desktop"]
    },
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": ["dmg", "zip"],
      "artifactName": "Anchor-Desktop-mac.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Anchor Desktop records your microphone during a call you choose to record.",
        "NSAudioCaptureUsageDescription": "Anchor Desktop captures other participants' audio from your call so it can transcribe the conversation."
      }
    },
    "afterSign": "build/afterSign.js",
    "dmg": {
      "sign": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": ["nsis"],
      "artifactName": "Anchor-Desktop-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
